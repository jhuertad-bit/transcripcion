# Candidate profile: build/import/inference validation is required before promotion.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HOME=/tmp/huggingface
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY docker/requirements-gpu.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && pip check \
    && python -c "from nemo.collections.asr.models import ASRModel; from transformers import AutoModelForAudioFrameClassification" \
    && pip freeze > /app/resolved-requirements.txt
COPY counter_presencial/ /app/counter_presencial/
ENTRYPOINT ["python", "-m", "counter_presencial.main"]
CMD ["acoustic"]
